#!/usr/bin/env python3
"""Wrapper eseguibile per lo scaffolding (equivale a: backup_odc init).

Crea la struttura cartelle della giornata/progetto (da config.yaml) e i file di
riferimento per Silverstack e DaVinci Resolve.
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(_HERE, "..", "src"))

from odc_backup.__main__ import main  # noqa: E402

if __name__ == "__main__":
    # Inserisce "init" come comando se non già presente.
    argv = sys.argv[1:]
    if not argv or argv[0] not in {"init", "files", "still", "report"}:
        argv = ["init"] + argv
    raise SystemExit(main(argv))
